    title: "Improved point scale climate projections using a block bootstrap simulation and quantile matching method"
    journal: "Climate Dynamics"
    volume: "41"
    start: "853"
    end: "866"
    year: 2013
    doi: "10.1007/s00382-013-1791-z"
